# Base URL of the backend API (must include the /api suffix).
# Local development:
VITE_API_URL=http://localhost:3000/api

# Production (set this in the Netlify dashboard, NOT here):
#   VITE_API_URL=https://your-backend.onrender.com/api

# Offline login fallback (optional — must match backend seed passwords)
# VITE_OWNER_PASSWORD=your-strong-owner-password
# VITE_MANAGER_PASSWORD=your-strong-manager-password
