// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS — mirror the TypeScript union types from the frontend.
// (@map keeps the DB value identical to the string the frontend already sends.)
// ─────────────────────────────────────────────────────────────────────────────

/// staticPassword.ts → StaticUserRole
enum Role {
  owner
  manager
}

/// transaction.types.ts → TransactionType
enum TransactionType {
  sale
  sale_adjustment
  expense_product
  expense_fixed
}

/// transaction.types.ts → PaymentMethod
enum PaymentMethod {
  cash
  bank
  bkash
}

/// transaction.types.ts → SalesChannel
enum SalesChannel {
  in_store
  foodpanda
  foodi
}

/// menuItem.types.ts → NewOrderData.channel ("posChannel" on Transaction)
enum PosChannel {
  in_store
  takeaway
  delivery
}

/// transaction.types.ts → UnitType
enum UnitType {
  kg
  g
  L
  ml
  pcs
  box
  pack
}

/// transaction.types.ts → ReceiptStatus
enum ReceiptStatus {
  pending
  completed
  refunded
  voided
}

/// menuItem.types.ts → DiscountType
enum DiscountType {
  flat
  percent
}

/// menuItem.types.ts → MenuCategory (spaces preserved via @map)
enum MenuCategory {
  AddOn      @map("Add On")
  Affogato
  Chicken
  Coffee
  IcedCoffee @map("Iced Coffee")
  MilkTea    @map("Milk Tea")
  Mocktails
  Pasta
  Shakes
  Sides
  WaffleMenu @map("Waffle Menu")
}

/// stock.types.ts → StockMovementType
enum StockMovementType {
  purchase
  pos_deduction
  wastage
  adjustment
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────────────────────────────────────

/// staticPassword.ts → StaticUser + auth.service.ts → User
/// Login is role + password only (no email). One account per role.
/// passwordHash is server-only and never returned to the client.
model User {
  id           String   @id @default(cuid())
  /// Human-readable reference code (e.g. USR-0001). Generated by a DB sequence.
  code         String?  @unique @default(dbgenerated("('USR-'::text || lpad((nextval('user_code_seq'::regclass))::text, 4, '0'::text))"))
  name         String
  passwordHash String
  role         Role     @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fundMovements       FundMovement[]
  deliverySettlements DeliverySettlement[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// ERP LEDGER (sales + expenses)
// Single table backing /sales and /expenses, matching transaction.types.ts.
// ─────────────────────────────────────────────────────────────────────────────

/// transaction.types.ts → Transaction
model Transaction {
  id     String          @id @default(cuid())
  /// Human-readable reference code (e.g. TXN-000123). Generated by a DB sequence.
  code   String?         @unique @default(dbgenerated("('TXN-'::text || lpad((nextval('txn_code_seq'::regclass))::text, 6, '0'::text))"))
  type   TransactionType
  amount Decimal         @db.Decimal(12, 2)
  method PaymentMethod?

  /// Expense/product grouping label when provided by API or forms.
  category    String?
  /// Sales channel (sale rows only).
  channel     SalesChannel?
  description String        @default("")

  // Product-expense detail (expense_product rows).
  quantity  Decimal?  @db.Decimal(12, 3)
  unit      UnitType?
  unitPrice Decimal?  @db.Decimal(12, 2)
  supplier  String?

  /// Business date of the transaction (frontend sends ISO; stored as timestamp).
  date DateTime

  // ── Receipt / POS metadata (sale rows) ──────────────────────────────────────
  cashier         String?
  customerName    String?
  loyaltyMemberId String?
  /// Per-line receipt breakdown (ReceiptLine[]). Snapshot kept on the ledger row
  /// so historical receipts stay intact even if menu prices change later.
  receiptLines    Json?
  discountAmount  Decimal?       @db.Decimal(12, 2)
  vatRatePercent  Decimal?       @db.Decimal(5, 2)
  receiptStatus   ReceiptStatus?
  orderNumber     String?
  tableNumber     String?
  posChannel      PosChannel?
  giftItemCount   Int?
  giftTotalValue  Decimal?       @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional link back to the POS order that produced this sale row.
  order Order?

  fixedCostRecord    FixedCostRecord?
  productCostRecord  ProductCostRecord?
  deliverySettlement DeliverySettlement?

  @@index([date])
  @@index([type])
  @@index([channel])
  @@index([type, date])
  @@index([type, receiptStatus, date])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPENSES — catalogs + detail records (ledger row stays on Transaction)
// ─────────────────────────────────────────────────────────────────────────────

/// Supplier master list — shared with Suppliers page and product-cost forms.
model Supplier {
  id        String   @id @default(cuid())
  /// Human-readable reference code (e.g. SUP-0001). Generated by a DB sequence.
  code      String?  @unique @default(dbgenerated("('SUP-'::text || lpad((nextval('supplier_code_seq'::regclass))::text, 4, '0'::text))"))
  name      String   @unique
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productCosts ProductCostRecord[]

  @@map("suppliers")
}

/// Saved fixed-cost description names (rent, utilities, etc.).
model FixedCostItem {
  id        String   @id @default(cuid())
  /// Human-readable reference code (e.g. FCI-0001). Generated by a DB sequence.
  code      String?  @unique @default(dbgenerated("('FCI-'::text || lpad((nextval('fixed_cost_item_code_seq'::regclass))::text, 4, '0'::text))"))
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records FixedCostRecord[]

  @@map("fixed_cost_items")
}

/// Saved product / ingredient names for inventory purchases.
model ProductCostItem {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records ProductCostRecord[]

  @@map("product_cost_items")
}

/// One row per fixed-cost expense — mirrors the ledger transaction.
model FixedCostRecord {
  id              String         @id @default(cuid())
  transactionId   String         @unique
  transaction     Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fixedCostItemId String?
  fixedCostItem   FixedCostItem? @relation(fields: [fixedCostItemId], references: [id], onDelete: SetNull)
  nameSnapshot    String
  description     String         @default("")
  amount          Decimal        @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  date            DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([fixedCostItemId])
  @@map("fixed_cost_records")
}

/// One row per product-cost expense — mirrors the ledger transaction.
model ProductCostRecord {
  id                String           @id @default(cuid())
  transactionId     String           @unique
  transaction       Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productCostItemId String?
  productCostItem   ProductCostItem? @relation(fields: [productCostItemId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  nameSnapshot      String
  supplierSnapshot  String?
  quantity          Decimal?         @db.Decimal(12, 3)
  unit              UnitType?
  unitPrice         Decimal?         @db.Decimal(12, 2)
  amount            Decimal          @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  date              DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([productCostItemId])
  @@index([supplierId])
  @@map("product_cost_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// POS — MENU + ORDERS
// ─────────────────────────────────────────────────────────────────────────────

/// menuItem.types.ts → MenuItem
model MenuItem {
  id          String       @id @default(cuid())
  name        String
  category    MenuCategory
  price       Decimal      @db.Decimal(12, 2)
  available   Boolean      @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([category])
  @@map("menu_items")
}

/// menuItem.types.ts → NewOrderData
model Order {
  id            String         @id @default(cuid())
  /// Human-readable reference code (e.g. ORD-000123). Generated by a DB sequence.
  code          String?        @unique @default(dbgenerated("('ORD-'::text || lpad((nextval('order_code_seq'::regclass))::text, 6, '0'::text))"))
  orderNumber   String         @unique
  customerName  String         @default("")
  tableNumber   String         @default("")
  paymentMethod PaymentMethod?
  channel       PosChannel

  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(12, 2)
  tax           Decimal?      @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  customerPaid  Decimal       @db.Decimal(12, 2)
  changeAmount  Decimal       @db.Decimal(12, 2)
  cashierName   String        @default("")

  giftItemCount  Int?
  giftTotalValue Decimal? @db.Decimal(12, 2)

  /// NewOrderData.createdAt (ISO from POS); kept distinct from row insert time.
  createdAt DateTime
  updatedAt DateTime @updatedAt

  items OrderItem[]

  /// The sale Transaction posted to the ERP ledger once the order is paid.
  saleTransactionId String?      @unique
  saleTransaction   Transaction? @relation(fields: [saleTransactionId], references: [id])

  @@index([createdAt])
  @@map("orders")
}

/// menuItem.types.ts → OrderItem (with price/name snapshot for history)
model OrderItem {
  id      String  @id @default(cuid())
  /// Human-readable reference code (e.g. OIT-000123). Generated by a DB sequence.
  code    String? @unique @default(dbgenerated("('OIT-'::text || lpad((nextval('order_item_code_seq'::regclass))::text, 6, '0'::text))"))
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])

  /// Item name/price captured at sale time (menu items can change/be deleted).
  nameSnapshot String
  unitPrice    Decimal @db.Decimal(12, 2)
  quantity     Int

  notes      String?
  isGift     Boolean @default(false)
  giftReason String?

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY (stock.types.ts)
// ─────────────────────────────────────────────────────────────────────────────

/// stock.types.ts → StockItem
model StockItem {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  category    String
  unit        UnitType
  /// Reorder threshold (qty).
  parLevel    Decimal  @db.Decimal(12, 3)
  /// Last known unit valuation (BDT) for shelf-value estimates.
  unitCostBdt Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
  lots      StockLot[]

  @@map("stock_items")
}

/// stock.types.ts → StockMovement
model StockMovement {
  id     String            @id @default(cuid())
  itemId String
  item   StockItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type   StockMovementType

  /// Positive adds stock; negative consumes.
  qtySigned Decimal @db.Decimal(12, 3)
  note      String?
  summary   String?

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([type])
  @@map("stock_movements")
}

/// stock.types.ts → StockLot (optional expiry batch layer)
model StockLot {
  id     String    @id @default(cuid())
  itemId String
  item   StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  qty        Decimal   @db.Decimal(12, 3)
  /// null = ambient / unknown expiry.
  expiryDate DateTime? @db.Date

  createdAt DateTime @default(now())

  @@index([itemId])
  @@map("stock_lots")
}

// ─────────────────────────────────────────────────────────────────────────────
// FUND MANAGEMENT — internal transfers between liquidity accounts
// ─────────────────────────────────────────────────────────────────────────────

/// Internal ERP account types (cash drawer, bank, bKash, reserve fund).
enum FundAccountType {
  cash
  bank
  bkash
  reserve
}

/// Fund Management movement types (mirrors FundManagement.tsx form).
enum FundMovementType {
  transfer
  add
  withdraw
  opening
}

/// Master list of fund accounts with materialized running balances.
model FundAccount {
  id        String          @id @default(cuid())
  type      FundAccountType @unique
  label     String
  balance   Decimal         @default(0) @db.Decimal(12, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  movementsFrom FundMovement[] @relation("FundMovementFrom")
  movementsTo   FundMovement[] @relation("FundMovementTo")

  @@map("fund_accounts")
}

/// Dedicated ledger for internal fund transfers — single source of truth.
model FundMovement {
  id              String           @id @default(cuid())
  /// Human-readable reference code (e.g. FND-000001). Generated by a DB sequence.
  code            String?          @unique @default(dbgenerated("('FND-'::text || lpad((nextval('fund_movement_code_seq'::regclass))::text, 6, '0'::text))"))
  movementType    FundMovementType @map("movement_type")
  fromAccountId   String?          @map("from_account_id")
  fromAccount     FundAccount?     @relation("FundMovementFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId     String?          @map("to_account_id")
  toAccount       FundAccount?     @relation("FundMovementTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amount          Decimal          @db.Decimal(12, 2)
  transactionDate DateTime         @map("transaction_date")
  notes           String           @default("")
  createdById     String?          @map("created_by")
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  deliverySettlement DeliverySettlement?

  @@index([transactionDate])
  @@index([movementType])
  @@map("fund_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// DELIVERY PLATFORM SETTLEMENTS (Foodpanda / Foodi income reconciliation)
// A settlement is the platform's periodic invoice — a receivable, not a sale.
// The actual cash deposit is recorded via the existing FundMovement machinery
// (movementType "add") so account balances stay authoritative in one place.
// ─────────────────────────────────────────────────────────────────────────────

/// Third-party delivery platforms we receive settlements from.
enum DeliveryPlatform {
  foodpanda
  foodi
  other
}

/// Settlement lifecycle — mirrors the plain pending → received flow of a real invoice.
enum SettlementStatus {
  pending
  received
  disputed
}

/// Foodpanda/Foodi settlement — one row per invoice/statement period.
model DeliverySettlement {
  id               String           @id @default(cuid())
  /// Human-readable reference code (e.g. SET-000001). Generated by a DB sequence.
  code             String?          @unique @default(dbgenerated("('SET-'::text || lpad((nextval('delivery_settlement_code_seq'::regclass))::text, 6, '0'::text))"))
  platform         DeliveryPlatform
  /// Free-text platform name when platform = "other".
  platformOther    String?          @map("platform_other")
  /// Invoice / statement number from the platform (optional — not always provided).
  settlementNumber String?          @map("settlement_number")

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  invoiceDate DateTime @map("invoice_date")

  grossAmount      Decimal @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(12, 2)
  vatOnService     Decimal @default(0) @map("vat_on_service") @db.Decimal(12, 2)
  /// Receivable = gross − commission − VAT on service (computed by the service).
  netAmount        Decimal @map("net_amount") @db.Decimal(12, 2)

  /// Actual amount deposited — set only once received (can differ slightly from netAmount).
  netAmountReceived Decimal?         @map("net_amount_received") @db.Decimal(12, 2)
  receivedDate      DateTime?        @map("received_date")
  /// Internal account the deposit landed in — reuses FundAccountType, no new concept.
  bankAccount       FundAccountType? @map("bank_account")

  status SettlementStatus @default(pending)
  notes  String           @default("")

  /// Linked FundMovement — only used when bankAccount = "reserve" (not a real
  /// sales payment method, so those deposits stay Fund-Management-only and are
  /// intentionally excluded from Sales dashboards/reports).
  fundMovementId String?       @unique @map("fund_movement_id")
  fundMovement   FundMovement? @relation(fields: [fundMovementId], references: [id], onDelete: SetNull)

  /// Linked sale Transaction — used when bankAccount = cash/bank/bkash so the
  /// received amount counts as real sales revenue (Dashboard, Reports, Order
  /// History all read from this same ledger — no separate wiring needed).
  saleTransactionId String?      @unique @map("sale_transaction_id")
  saleTransaction   Transaction? @relation(fields: [saleTransactionId], references: [id], onDelete: SetNull)

  createdById String?  @map("created_by")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([platform, periodStart])
  @@index([status])
  @@map("delivery_settlements")
}
